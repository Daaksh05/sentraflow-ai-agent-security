# =================================================================
# SentraFlow Environment Configuration Example
# Copy this file to .env and configure values for your environment.
# NEVER commit real credentials or secret keys to version control.
# =================================================================

# Server & Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Backend Security / CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
API_V1_PREFIX=/api/v1

# Database Configuration (PostgreSQL)
POSTGRES_USER=sentraflow_user
POSTGRES_PASSWORD=sentraflow_password
POSTGRES_DB=sentraflow_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sentraflow_user:sentraflow_password@localhost:5432/sentraflow_db

# Event & State Handling (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# AI / NVIDIA Nemotron Provider Configuration
# Supported providers: nemotron_nim, nemotron_api, mock
AI_MODEL_PROVIDER=mock
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=nvidia/nemotron-4-340b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
